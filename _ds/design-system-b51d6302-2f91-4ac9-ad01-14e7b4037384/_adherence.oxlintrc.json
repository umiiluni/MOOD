{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/menu/**",
              "ui_kits/menu/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Antonio|Encode Sans Semi Condensed))/i]",
        "message": "Font not provided by the design system. Available: Antonio, Encode Sans Semi Condensed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Band'] > JSXAttribute > JSXIdentifier[name!=/^(?:category|label|count|open|onClick|children|key|ref|className|style|children)$/]",
        "message": "<Band> doesn't accept that prop. Declared props: category, label, count, open, onClick, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Band'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:cafeteria|bebidas|panaderia|dulces|combos)$/]",
        "message": "<Band> category must be one of 'cafeteria' | 'bebidas' | 'panaderia' | 'dulces' | 'combos'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|description|price|photo|onClick|key|ref|className|style|children)$/]",
        "message": "<ProductRow> doesn't accept that prop. Declared props: name, description, price, photo, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|description|price|photo|category|onClose|key|ref|className|style|children)$/]",
        "message": "<ProductSheet> doesn't accept that prop. Declared props: name, description, price, photo, category, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductSheet'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:cafeteria|bebidas|panaderia|dulces|combos)$/]",
        "message": "<ProductSheet> category must be one of 'cafeteria' | 'bebidas' | 'panaderia' | 'dulces' | 'combos'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|note|key|ref|className|style|children)$/]",
        "message": "<SubHeading> doesn't accept that prop. Declared props: children, note."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Band": {
        "replaces": []
      },
      "ProductRow": {
        "replaces": []
      },
      "ProductSheet": {
        "replaces": []
